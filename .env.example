# ─── TenderPulse — configuration (copier vers .env puis adapter) ───────────────

# Clé d'administration de l'API et de la console opérateur. À CHANGER : `openssl rand -hex 32`
ADMIN_API_KEY=change-me-admin-key

# Base de données PostgreSQL
POSTGRES_PASSWORD=tenderpulse

# Ports exposés sur la machine hôte
FRONTEND_PORT=8080
BACKEND_PORT=8000
PUBLIC_APP_URL=http://localhost:8080

# Collecte quotidienne du BOAMP (heure de Paris)
COLLECT_ENABLED=true
COLLECT_HOUR=6
COLLECT_MINUTE=30
COLLECT_LOOKBACK_DAYS=2
COLLECT_MAX_RECORDS=5000
# Source des avis. Pour le jeu de test : http://host.docker.internal:8099 (voir jeu-de-test/README.md)
BOAMP_BASE_URL=https://boamp-datadila.opendatasoft.com

# Analyse fine par LLM — « none » : scoring 100 % déterministe (aucun coût, aucune clé requise)
#   openai : toute API compatible OpenAI (OpenAI, Mistral, OpenRouter, vLLM…)
#   ollama : modèle local, ex. LLM_BASE_URL=http://host.docker.internal:11434 et LLM_MODEL=llama3.1
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_PER_RUN=200
LLM_CONCURRENCY=3

# Envoi du digest par e-mail (facultatif). Sans SMTP, le digest reste disponible en HTML via l'API et l'interface.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
DIGEST_AUTO_SEND=false
